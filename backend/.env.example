# Generated together with root .env by python scripts/bootstrap_env.py.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://flowforge:replace-with-generated-secret@127.0.0.1:15432/flowforge
REDIS_URL=redis://:replace-with-generated-secret@127.0.0.1:6379/0
RABBITMQ_URL=amqp://flowforge:replace-with-generated-secret@127.0.0.1:5672//
MINIO_ENDPOINT=http://127.0.0.1:9000
DEPENDENCY_TIMEOUT_SECONDS=3
# JSON array of exact frontend origins. Use HTTPS in staging/production.
TRUSTED_ORIGINS=["http://127.0.0.1:3000"]
SESSION_ABSOLUTE_SECONDS=604800
SESSION_IDLE_SECONDS=86400
